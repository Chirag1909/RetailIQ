# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.env.local
.env.*.local
venv/
env/
ENV/
.venv/

# Large raw & processed data (official dataset files kept locally)
online+retail/
data/raw/*.xlsx
data/raw/*.csv
data/raw/*.zip
data/processed/*.csv
data/processed/*.parquet
*.xlsx

# Database
*.db
*.sqlite
*.sqlite3
retailiq.db
retailiq_test.db

# Machine Learning Large Artifacts & Cache
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.json
