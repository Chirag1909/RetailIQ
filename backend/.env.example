# RetailIQ Backend Environment Variables
PROJECT_NAME="RetailIQ"
PROJECT_VERSION="1.0.0"

# Primary PostgreSQL Database URL (or leave blank for SQLite local development fallback)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/retailiq_db
DATABASE_URL=sqlite:///./retailiq.db

# API Configuration
API_V1_STR="/api"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
